{
  "name": "mrmd-vscode-new",
  "displayName": "mrmd - Markdown that Runs",
  "description": "Execute code blocks in markdown files with real-time output",
  "version": "0.1.1",
  "publisher": "mrmd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/mrmd-packages"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Notebooks",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "markdown",
    "notebook",
    "python",
    "literate programming",
    "jupyter",
    "repl"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mrmd.runBlock",
        "title": "Run Code Block",
        "category": "mrmd"
      },
      {
        "command": "mrmd.runBlockAdvance",
        "title": "Run Code Block and Advance",
        "category": "mrmd"
      },
      {
        "command": "mrmd.runAllBlocks",
        "title": "Run All Code Blocks",
        "category": "mrmd"
      },
      {
        "command": "mrmd.interrupt",
        "title": "Interrupt Execution",
        "category": "mrmd"
      },
      {
        "command": "mrmd.restartRuntime",
        "title": "Restart Python Runtime",
        "category": "mrmd"
      },
      {
        "command": "mrmd.deleteOutput",
        "title": "Delete Output Block",
        "category": "mrmd"
      },
      {
        "command": "mrmd.deleteAllOutputs",
        "title": "Delete All Output Blocks",
        "category": "mrmd"
      },
      {
        "command": "mrmd.toggleCollapseOutput",
        "title": "Toggle Collapse Output",
        "category": "mrmd"
      },
      {
        "command": "mrmd.collapseAllOutputs",
        "title": "Collapse All Outputs",
        "category": "mrmd"
      },
      {
        "command": "mrmd.expandAllOutputs",
        "title": "Expand All Outputs",
        "category": "mrmd"
      },
      {
        "command": "mrmd.navigateUp",
        "title": "Navigate to Previous Code Block",
        "category": "mrmd"
      },
      {
        "command": "mrmd.navigateDown",
        "title": "Navigate to Next Code Block",
        "category": "mrmd"
      },
      {
        "command": "mrmd.startServer",
        "title": "Start mrmd Services",
        "category": "mrmd"
      },
      {
        "command": "mrmd.stopServer",
        "title": "Stop mrmd Services",
        "category": "mrmd"
      },
      {
        "command": "mrmd.showStatus",
        "title": "Show mrmd Status",
        "category": "mrmd"
      },
      {
        "command": "mrmd.refreshVariables",
        "title": "Refresh Variables",
        "category": "mrmd"
      },
      {
        "command": "mrmd.clearVariables",
        "title": "Clear All Variables",
        "category": "mrmd"
      },
      {
        "command": "mrmd.copyVariable",
        "title": "Copy Variable Name",
        "category": "mrmd"
      },
      {
        "command": "mrmd.clearOutputs",
        "title": "Clear Rich Outputs",
        "category": "mrmd"
      },
      {
        "command": "mrmd.checkSetup",
        "title": "Check Setup / Install mrmd-python",
        "category": "mrmd"
      }
    ],
    "keybindings": [
      {
        "command": "mrmd.runBlock",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mrmd.runBlockAdvance",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mrmd.runAllBlocks",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mrmd.interrupt",
        "key": "escape",
        "when": "editorTextFocus && editorLangId == markdown && mrmd.isExecuting"
      },
      {
        "command": "mrmd.deleteOutput",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mrmd.toggleCollapseOutput",
        "key": "ctrl+shift+\\",
        "mac": "cmd+shift+\\",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mrmd.navigateUp",
        "key": "alt+pageup",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mrmd.navigateDown",
        "key": "alt+pagedown",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "mrmd",
      "properties": {
        "mrmd.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start mrmd services when opening a markdown file"
        },
        "mrmd.orchestratorUrl": {
          "type": "string",
          "default": "http://localhost:41580",
          "description": "URL of the mrmd orchestrator (HTTP API)"
        },
        "mrmd.runtimeUrl": {
          "type": "string",
          "default": "",
          "description": "Direct URL to mrmd-python MRP endpoint (bypasses orchestrator). Leave empty to use orchestrator."
        },
        "mrmd.syncUrl": {
          "type": "string",
          "default": "",
          "description": "URL of mrmd-sync WebSocket server for collaboration (future)"
        },
        "mrmd.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show 'Run' buttons above code blocks"
        },
        "mrmd.defaultSession": {
          "type": "string",
          "default": "shared",
          "enum": ["shared", "dedicated"],
          "description": "Default session mode: 'shared' (all files share one runtime) or 'dedicated' (per-file runtime)"
        },
        "mrmd.juiceLevel": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 4,
          "description": "Default AI juice level (0=Quick, 1=Balanced, 2=Deep, 3=Maximum, 4=Ultimate)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mrmd",
          "title": "mrmd",
          "icon": "resources/icons/mrmd.svg"
        }
      ]
    },
    "views": {
      "mrmd": [
        {
          "id": "mrmd.variablePanel",
          "name": "Variables",
          "type": "webview"
        },
        {
          "id": "mrmd.variableExplorer",
          "name": "Variables (Tree)",
          "type": "tree",
          "visibility": "collapsed"
        },
        {
          "id": "mrmd.outputPanel",
          "name": "Rich Outputs",
          "type": "webview"
        }
      ]
    },
    "languages": [
      {
        "id": "mrmd-output",
        "aliases": ["MRMD Output"],
        "extensions": [],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/markdown.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch",
    "lint": "eslint src --ext ts",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "yjs": "^13.6.0",
    "y-websocket": "^2.0.0",
    "y-protocols": "^1.0.6",
    "lib0": "^0.2.0"
  }
}
