{
  "name": "mrmd",
  "displayName": "mrmd — Markdown Notebooks",
  "description": "Run code blocks in markdown files. Ctrl+Enter to execute.",
  "version": "0.2.0",
  "publisher": "mrmd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaximeRivest/mrmd-packages"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Notebooks",
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "notebook",
    "python",
    "r",
    "julia",
    "bash",
    "literate programming",
    "repl"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mrmd.run",
        "title": "Run Code Block",
        "category": "mrmd"
      },
      {
        "command": "mrmd.runAndAdvance",
        "title": "Run Code Block and Advance",
        "category": "mrmd"
      },
      {
        "command": "mrmd.interrupt",
        "title": "Interrupt Execution",
        "category": "mrmd"
      }
    ],
    "keybindings": [
      {
        "command": "mrmd.run",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mrmd.runAndAdvance",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mrmd.interrupt",
        "key": "escape",
        "when": "editorTextFocus && editorLangId == markdown && mrmd.isExecuting"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run build -- --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "mrmd": "file:../mrmd"
  }
}
